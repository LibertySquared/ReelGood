<Window x:Class="ReelGood.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReelGood Studio" Height="960" Width="1500" MinHeight="760" MinWidth="1120"
        Background="#0B0D0F" Foreground="#F2F3F4" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#14171A"/><SolidColorBrush x:Key="Line" Color="#292D32"/><SolidColorBrush x:Key="Muted" Color="#8E949B"/><SolidColorBrush x:Key="Lime" Color="#D5FF5B"/>
    <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Background" Value="#202428"/><Setter Property="Foreground" Value="#ECEEF0"/><Setter Property="BorderBrush" Value="#343A40"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="TrackButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="10"/></Style>
    <Style x:Key="PanelBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
  </Window.Resources>
  <Grid x:Name="RootGrid" Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*" MinHeight="300"/><RowDefinition Height="6"/><RowDefinition Height="300" MinHeight="220"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,8" Padding="14,7">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" Background="#2A321D" CornerRadius="17" BorderBrush="#687939" BorderThickness="1"><TextBlock Text="◉" Foreground="{StaticResource Lime}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="ReelGood" FontSize="16" FontWeight="Bold"/><TextBlock Text="VIDEO WORKSPACE" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="＋  Import media" Style="{StaticResource ActionButton}" Margin="0,0,7,0" Click="Import_Click"/><Button Content="Extract audio" Style="{StaticResource ActionButton}" Margin="0,0,7,0" Click="ExtractAudio_Click"/><Button Content="✦  Scan cues" Style="{StaticResource ActionButton}" Margin="0,0,7,0" Click="Analyze_Click"/><Button x:Name="RecordButton" Content="●  Record" Style="{StaticResource ActionButton}" Background="#E84D65" BorderBrush="#E84D65" Click="Record_Click"/><Button Content="⚙" ToolTip="Choose FFmpeg media engine" Style="{StaticResource ActionButton}" Margin="7,0,0,0" Padding="9,8" Click="ChooseEngine_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="185"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="380"/><ColumnDefinition Width="6"/><ColumnDefinition Width="315" MinWidth="260"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="13"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="PROJECT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ProjectName" Text="Untitled project" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,13"/><TextBlock Text="MEDIA" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><Button Content="＋  Import video" Style="{StaticResource ActionButton}" HorizontalContentAlignment="Left" Margin="0,7,0,0" Click="Import_Click"/><TextBlock x:Name="MediaName" Text="No media loaded" Foreground="#ADB2B8" FontSize="11" TextWrapping="Wrap" Margin="2,9,0,0"/><TextBlock x:Name="MediaDetails" Text="Import a video to begin." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="2,4,0,0"/><Border Height="1" Background="{StaticResource Line}" Margin="0,15,0,12"/><TextBlock Text="RECORDING INPUTS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><CheckBox x:Name="SystemAudioCheck" IsChecked="True" Foreground="#DEE0E3" Margin="0,8,0,0"><StackPanel><TextBlock Text="System audio" FontSize="11"/><TextBlock Text="Game and party sound" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></CheckBox><CheckBox x:Name="MicCheck" IsChecked="True" Foreground="#DEE0E3" Margin="0,8,0,0"><StackPanel><TextBlock Text="Microphone" FontSize="11"/><TextBlock Text="Saved as a separate track" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></CheckBox></StackPanel><TextBlock x:Name="EngineStatus" DockPanel.Dock="Bottom" Text="Media engine not set" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0"/></DockPanel></Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#252A2F"/>
      <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid Grid.Row="0"><TextBlock Text="PREVIEW" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="PreviewStatus" Text="Import a video to preview" Foreground="#B4B8BD" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><Border Grid.Row="1" Background="#08090A" CornerRadius="5" BorderBrush="#292D32" BorderThickness="1"><Grid><MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaOpened="VideoPreview_MediaOpened"/><StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◉" FontSize="42" Foreground="#586238" HorizontalAlignment="Center"/><TextBlock Text="Your video preview" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,2"/><TextBlock Text="Import media to start your edit" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Grid></Border><Grid Grid.Row="2" Margin="2,5,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="57"/><ColumnDefinition Width="*"/><ColumnDefinition Width="57"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="▶" Grid.Column="0" Style="{StaticResource ActionButton}" Padding="0" IsEnabled="False" Click="Play_Click"/><TextBlock x:Name="CurrentTime" Text="00:00" Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" IsEnabled="False" PreviewMouseLeftButtonDown="SeekSlider_MouseLeftButtonDown" PreviewMouseLeftButtonUp="SeekSlider_MouseLeftButtonUp"/><TextBlock x:Name="DurationText" Text="00:00" Grid.Column="3" FontFamily="Consolas" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button x:Name="MuteButton" Content="🔊" Grid.Column="4" Style="{StaticResource ActionButton}" Padding="0" Click="Mute_Click"/></Grid></Grid></Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#252A2F"/>
      <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="COMEDY CUES" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="CueSummary" Grid.Row="1" Text="Run a scan to find moments for review." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8"/><ListBox x:Name="CueList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#ECEEF0" SelectionChanged="CueList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Background="#1B1F21" BorderBrush="#30363A" BorderThickness="1" CornerRadius="5" Margin="0,3" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding DisplayText}" FontSize="10" TextWrapping="Wrap"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0"><Button Content="Keep" Tag="Keep" Style="{StaticResource TrackButton}" Margin="0,0,5,0" Click="ReviewCue_Click"/><Button Content="Skip" Tag="Skip" Style="{StaticResource TrackButton}" Click="ReviewCue_Click"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="CueHint" Grid.Row="3" Text="Audio-level cues are suggestions, not comedy judgments. Keep / Skip feedback stays on this PC." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,8"/><StackPanel Grid.Row="4"><TextBlock Text="YOUR EDITING PREFERENCE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold"/><TextBox x:Name="PreferenceBox" Text="Favor clear reactions; include a little setup before the moment." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="65" Margin="0,5,0,5" Padding="6" Background="#0C0E10" Foreground="#E8EAEC" BorderBrush="#343A40"/><Button Content="Review preference change" Style="{StaticResource TrackButton}" HorizontalAlignment="Left" Click="ApplyPreference_Click"/><TextBlock x:Name="PreferenceStatus" Text="Your approval is required before saving preferences." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border>
    </Grid>
    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#252A2F"/>
    <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions><Grid Grid.Row="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="TIMELINE" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="  Video + separate audio tracks" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="  Zoom" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="12,0,3,0"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="8" Value="2.2" Width="100" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Add cue at playhead" Style="{StaticResource TrackButton}" Margin="0,0,6,0" Click="AddCueAtPlayhead_Click"/><Button Content="Export trimmed clip" Style="{StaticResource TrackButton}" Click="ExportClip_Click"/></StackPanel></Grid><ScrollViewer x:Name="TimelineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0C0E10"><Grid x:Name="TimelineTracks" HorizontalAlignment="Left" VerticalAlignment="Top"/></ScrollViewer><TextBlock Grid.Row="2" x:Name="TimelineStatus" Text="Drag the V1 clip edges to trim · audio tracks remain separate · cue flags stay on the ruler" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/></Grid></Border>
    <Grid Grid.Row="4" Margin="2,5,2,0"><TextBlock x:Name="StatusText" Text="Ready · Local project" Foreground="#A8CE71" FontSize="9"/><TextBlock Text="ReelGood Studio · WINDOWS DESKTOP" Foreground="#737A80" FontSize="9" HorizontalAlignment="Right"/></Grid>
  </Grid>
</Window>
